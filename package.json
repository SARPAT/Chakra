{
  "name": "chakra-middleware",
  "version": "0.1.0",
  "description": "Priority-aware adaptive load shedding for Node.js: keeps critical routes alive when capacity runs short",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "bench": "npm run build && npm --prefix bench ci --no-audit --no-fund && node bench/run.js"
  },
  "keywords": [
    "middleware",
    "load-shedding",
    "adaptive-concurrency",
    "overload-protection",
    "graceful-degradation",
    "express",
    "fastify"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
