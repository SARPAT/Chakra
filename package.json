{
  "name": "chakra-middleware",
  "version": "0.1.0",
  "description": "Middleware framework for intelligent graceful degradation during traffic surges",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "keywords": [
    "middleware",
    "graceful-degradation",
    "express",
    "load-management"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SARPAT/Chakra.git"
  },
  "bugs": {
    "url": "https://github.com/SARPAT/Chakra/issues"
  },
  "homepage": "https://github.com/SARPAT/Chakra#readme",
  "dependencies": {
    "@types/express": "^4.17.21",
    "better-sqlite3": "^11.0.0",
    "express": "^4.21.0",
    "js-yaml": "^4.1.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "prettier": "^3.9.9",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^1.6.0"
  }
}
